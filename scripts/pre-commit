#!/usr/bin/env bash
#
# Pre-commit hook for kiro-go-gw
# Checks Go code quality and prevents problematic commits

set -e

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	against=$(git hash-object -t tree /dev/null)
fi

exec 1>&2

# Get allownonascii from git config (if set)
allownonascii=$(git config --type=bool hooks.allownonascii 2>/dev/null || echo "false")

if [ "$allownonascii" != "true" ] &&
	test $(git diff-index --cached --name-only --diff-filter=A -z $against |
	  LC_ALL=C tr -d '[ -~]\0' | wc -c) != 0
then
	cat <<\EOF
Error: Attempt to add a non-ASCII file name.
This can cause problems if you want to work with people on other platforms.
To be portable it is advisable to rename the file.
If you know what you are doing you can disable this check using:
  git config hooks.allownonascii true
EOF
	exit 1
fi

if git diff-index --check --cached $against --
then
	echo "Whitespace check passed"
fi

echo "Running go vet..."
go vet ./...

echo "Checking formatting..."
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
    echo "Files not formatted:"
    echo "$unformatted"
    exit 1
fi

echo "Running tests..."
go test -race ./...

echo "Checking go mod tidy..."
go mod tidy -e
if [ -n "$(git diff --stat go.mod go.sum)" ]; then
    echo "go.mod or go.sum need updates:"
    git diff go.mod go.sum
    exit 1
fi

if [ -f flake.nix ] && command -v nix &> /dev/null; then
    echo "Running nix flake check..."
    nix flake check
fi
