# Kiro Gateway Configuration
# Copy this file to .env and fill in your values

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# API Key (required) - Clients must use this in Authorization header
PROXY_API_KEY=my-super-secret-password-123

# Kiro Authentication - Choose ONE method:

# Option 1: Refresh Token (from Kiro IDE traffic)
# REFRESH_TOKEN=your_refresh_token

# Option 2: JSON Credentials File (Kiro IDE or Enterprise)
# KIRO_CREDS_FILE=~/.aws/sso/cache/kiro-auth-token.json

# Option 3: kiro-cli SQLite Database (AWS SSO)
KIRO_CLI_DB_FILE=~/.local/share/kiro-cli/data.sqlite3

# Optional: AWS Profile ARN (for Kiro Desktop auth)
# PROFILE_ARN=arn:aws:codewhisperer:us-east-1:...

# Optional: AWS Region (default: us-east-1)
# KIRO_REGION=us-east-1

# Optional: Explicit AWS SSO OIDC credentials
# KIRO_CLIENT_ID=your_client_id
# KIRO_CLIENT_SECRET=your_client_secret
